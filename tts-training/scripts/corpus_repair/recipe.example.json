{
  "schema": 1,
  "policy": {
    "quiet_seconds": 0.3,
    "edge_seconds": 0.12,
    "vad_padding_seconds": 0.08,
    "vad_threshold": 0.35,
    "quiet_rms_floor": 0.0005,
    "quiet_rms_ceiling": 0.004,
    "quiet_speech_ratio": 0.025,
    "preferred_seconds": 8,
    "max_seconds": 35,
